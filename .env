# 数据库配置
DB_NAME=testhub
DB_USER=root
DB_PASSWORD=Aa123456
DB_HOST=127.0.0.1

# Django 配置
SECRET_KEY=your-secret-key-here
DEBUG=True

# 本地化配置
# 语言: 'en-us' (英语), 'zh-hans' (简体中文), 'ja' (日语), 'ko' (韩语) 等
# 时区: 参考 https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai

# 邮件配置（可选）
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=你的邮箱地址
EMAIL_HOST_PASSWORD=你的邮箱密码，注意SMTP是独立密码
DEFAULT_FROM_EMAIL=默认发件人，你的邮箱地址

# Selenium WebDriver 配置（用于传统 UI 自动化）
# 留空则使用本地 WebDriver（需要下载驱动），设置后使用远程 Selenium 容器
# 注意：AI 智能模式（browser-use）不需要此配置

# 多浏览器配置（推荐）
SELENIUM_CHROME_URL=http://localhost:4444/wd/hub
SELENIUM_FIREFOX_URL=http://localhost:4445/wd/hub

# 或使用统一配置（所有浏览器指向同一个 URL）
# SELENIUM_REMOTE_URL=http://localhost:4444/wd/hub